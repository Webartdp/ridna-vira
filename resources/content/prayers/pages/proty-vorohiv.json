[
  {
    "type": "heading",
    "title": "На справедливу відплату ворогу рідновіра та Рідної Віри",
    "id": "reading-1"
  },
  {
    "type": "prayer",
    "html": "Блискавка Перунова вражає,",
    "id": "reading-2"
  },
  {
    "type": "prayer",
    "html": "Духи надр виходять.",
    "id": "reading-3"
  },
  {
    "type": "prayer",
    "html": "Вітри попіл розносять.",
    "id": "reading-4"
  },
  {
    "type": "prayer",
    "html": "І немає спокійного місця",
    "id": "reading-5"
  },
  {
    "type": "prayer",
    "html": "На Землі (кому),",
    "id": "reading-6"
  },
  {
    "type": "prayer",
    "html": "Де б його не дістала",
    "id": "reading-7"
  },
  {
    "type": "prayer",
    "html": "Справедлива відплата",
    "id": "reading-8"
  },
  {
    "type": "prayer",
    "html": "За (назвати причину).",
    "id": "reading-9"
  },
  {
    "type": "prayer",
    "html": "Немає на Світі перешкод",
    "id": "reading-10"
  },
  {
    "type": "prayer",
    "html": "Для покарання",
    "id": "reading-11"
  },
  {
    "type": "prayer",
    "html": "Ворогу Рідної Віри та рідновіра (ім&#039;ярек).",
    "id": "reading-12"
  },
  {
    "type": "heading",
    "title": "На знищення бізнесу ворога Рідної Віри, рідновірів та Русі-України",
    "id": "reading-13"
  },
  {
    "type": "prayer",
    "html": "Град піде – посіви б’є,",
    "id": "reading-14"
  },
  {
    "type": "prayer",
    "html": "Сонце їх вижарює,",
    "id": "reading-15"
  },
  {
    "type": "prayer",
    "html": "Дощ затоплює.",
    "id": "reading-16"
  },
  {
    "type": "prayer",
    "html": "Не буде у ворога Рідної Віри,",
    "id": "reading-17"
  },
  {
    "type": "prayer",
    "html": "Рідновірів та Русі-України (ім&#039;ярек)",
    "id": "reading-18"
  },
  {
    "type": "prayer",
    "html": "Ні що їсти, ні що пити,",
    "id": "reading-19"
  },
  {
    "type": "prayer",
    "html": "Ні в чому ходити, ні на що сподіватись.",
    "id": "reading-20"
  },
  {
    "type": "prayer",
    "html": "Все їх життя руйнується,",
    "id": "reading-21"
  },
  {
    "type": "prayer",
    "html": "Як листок під градом,",
    "id": "reading-22"
  },
  {
    "type": "prayer",
    "html": "Всі справи згорають,",
    "id": "reading-23"
  },
  {
    "type": "prayer",
    "html": "Як дрова в печі.",
    "id": "reading-24"
  },
  {
    "type": "heading",
    "title": "На втрату ворогом влади над людьми",
    "id": "reading-25"
  },
  {
    "type": "prayer",
    "html": "Птахи відлітають,",
    "id": "reading-26"
  },
  {
    "type": "prayer",
    "html": "Звірі втікають,",
    "id": "reading-27"
  },
  {
    "type": "prayer",
    "html": "Влада покидає (ім&#039;ярек).",
    "id": "reading-28"
  },
  {
    "type": "prayer",
    "html": "Він без влади",
    "id": "reading-29"
  },
  {
    "type": "prayer",
    "html": "Як стовп у полі,",
    "id": "reading-30"
  },
  {
    "type": "prayer",
    "html": "Як камінь у річці,",
    "id": "reading-31"
  },
  {
    "type": "prayer",
    "html": "Як старець в дорозі",
    "id": "reading-32"
  },
  {
    "type": "prayer",
    "html": "Немає ні влади, ні грошей, нічого.",
    "id": "reading-33"
  },
  {
    "type": "heading",
    "title": "На погіршення стосунків між недобрими людьми",
    "id": "reading-34"
  },
  {
    "type": "prayer",
    "html": "Нитка рветься,",
    "id": "reading-35"
  },
  {
    "type": "prayer",
    "html": "Ниточки обриваються.",
    "id": "reading-36"
  },
  {
    "type": "prayer",
    "html": "Листя падає і",
    "id": "reading-37"
  },
  {
    "type": "prayer",
    "html": "Дерево сохне,",
    "id": "reading-38"
  },
  {
    "type": "prayer",
    "html": "Висихають ріки",
    "id": "reading-39"
  },
  {
    "type": "prayer",
    "html": "І річечки.",
    "id": "reading-40"
  },
  {
    "type": "prayer",
    "html": "Вся земля цих людей",
    "id": "reading-41"
  },
  {
    "type": "prayer",
    "html": "Стає пусткою",
    "id": "reading-42"
  },
  {
    "type": "prayer",
    "html": "І вони в ній – пустими місцями",
    "id": "reading-43"
  },
  {
    "type": "prayer",
    "html": "На віки-вічні, назавжди.",
    "id": "reading-44"
  },
  {
    "type": "prayer",
    "html": "До ворогів своїх іду",
    "id": "reading-45"
  },
  {
    "type": "prayer",
    "html": "По Божому сліду,",
    "id": "reading-46"
  },
  {
    "type": "prayer",
    "html": "Божими стопами:",
    "id": "reading-47"
  },
  {
    "type": "prayer",
    "html": "Хай вороги на мене рота не роззявляють,",
    "id": "reading-48"
  },
  {
    "type": "prayer",
    "html": "Очі не витріщають,",
    "id": "reading-49"
  },
  {
    "type": "prayer",
    "html": "Руки не розпускають.",
    "id": "reading-50"
  },
  {
    "type": "prayer",
    "html": "Хай станеться за словом моїм!",
    "id": "reading-51"
  },
  {
    "type": "prayer",
    "html": "Я стою на Землі своїй і звертаюся до Роду свого!",
    "id": "reading-52"
  },
  {
    "type": "prayer",
    "html": "Кличу Предків Кровних моїх!",
    "id": "reading-53"
  },
  {
    "type": "prayer",
    "html": "Закликаю Рідню по Духові!",
    "id": "reading-54"
  },
  {
    "type": "prayer",
    "html": "Призиваю всіх вірних Землі Української!",
    "id": "reading-55"
  },
  {
    "type": "prayer",
    "html": "Хто ходив добрим господарем",
    "id": "reading-56"
  },
  {
    "type": "prayer",
    "html": "по Землі цій, де я ходжу тепер –",
    "id": "reading-57"
  },
  {
    "type": "prayer",
    "html": "Встаньте непохитною стіною перед ворогами нашими!",
    "id": "reading-58"
  },
  {
    "type": "prayer",
    "html": "Хто пив колись Воду, що живить тепер мене і дітей моїх –",
    "id": "reading-59"
  },
  {
    "type": "prayer",
    "html": "Налийте Силою народ мій, щоб змити ворогів наших!",
    "id": "reading-60"
  },
  {
    "type": "prayer",
    "html": "Хто дихав Повітрям вільним під небом України –",
    "id": "reading-61"
  },
  {
    "type": "prayer",
    "html": "Підійміться до нас і розвійте ворогів наших!",
    "id": "reading-62"
  },
  {
    "type": "prayer",
    "html": "В чиїй душі палав Вогонь, іскри котрого у серці моїм –",
    "id": "reading-63"
  },
  {
    "type": "prayer",
    "html": "Повстаньте і спопеліть ворогів наших!",
    "id": "reading-64"
  },
  {
    "type": "prayer",
    "html": "Роде мій! Предки мої!",
    "id": "reading-65"
  },
  {
    "type": "prayer",
    "html": "Закликаю вас сьогодні, в час біди і небезпеки!",
    "id": "reading-66"
  },
  {
    "type": "prayer",
    "html": "Гляньте на нас! Почуйте заклик нащадків ваших!",
    "id": "reading-67"
  },
  {
    "type": "prayer",
    "html": "Повстаньте силою нашого Духу! Благаю вас про поміч!",
    "id": "reading-68"
  },
  {
    "type": "prayer",
    "html": "Встаньте поруч із народом моїм до бою!",
    "id": "reading-69"
  },
  {
    "type": "prayer",
    "html": "Примножте Силу нашу і Славу свою!",
    "id": "reading-70"
  },
  {
    "type": "prayer",
    "html": "Допоможіть вистояти і перемогти у цій битві!",
    "id": "reading-71"
  },
  {
    "type": "prayer",
    "html": "До перемоги!",
    "id": "reading-72"
  },
  {
    "type": "prayer",
    "html": "Хай буде так!",
    "id": "reading-73"
  },
  {
    "type": "prayer",
    "html": "Мара-Маронько, оминай бійців наших, захисників нашого роду та земель! Пусти свій гнів праведний на ворогів, вмертвляй їх, Жнице славна, без жалю та втоми! Хто прийшов до нас зі смертю, від руки Твоєї хай ту смерть пізнає!",
    "id": "reading-74"
  },
  {
    "type": "prayer",
    "html": "Боже, затули очі ворогам, бо не схотіли вони Правди бачити, то й шляхів, цілей, будинків та вояків наших їх очі не бачать нехай!",
    "id": "reading-75"
  },
  {
    "type": "prayer",
    "html": "Боже, заплутай шляхи ворожі, аби не могли вони орієнтуватися та просуватися, бо зійшли вони з шляху Світла!",
    "id": "reading-76"
  },
  {
    "type": "prayer",
    "html": "Боже, всели в ворожі серця жах та біль, бо жах і біль вони принесли з собою!",
    "id": "reading-77"
  },
  {
    "type": "prayer",
    "html": "А наших хлопців покрий бронею непробивною, бо на них броня молитов і любові!",
    "id": "reading-78"
  },
  {
    "type": "prayer",
    "html": "Та поверни наших воїнів живими та неушкодженими до домівок їхніх, бо боронять вони мир на своїй Землі, не руйнуючі даху будинку ближнього!",
    "id": "reading-79"
  },
  {
    "type": "prayer",
    "html": "Хай буде по слову моєму і по Силі та Волі Твоїй!",
    "id": "reading-80"
  },
  {
    "type": "prayer",
    "html": "України вороги, згиньте всі ви до ноги! Хай, при тямі ви чи сплячі, вам смердить лайно свиняче, дихання збиває ваше, лізе в рот, неначе каша. Хай смердючий цей привіт заганя вас на той світ!",
    "id": "reading-81"
  },
  {
    "type": "heading",
    "title": "Замовляння на Божу відплату",
    "id": "reading-82"
  },
  {
    "type": "prayer",
    "html": "Сили Божі многії закликаю,",
    "id": "reading-83"
  },
  {
    "type": "prayer",
    "html": "Батька Перуна до бою проводжаю.",
    "id": "reading-84"
  },
  {
    "type": "prayer",
    "html": "Гримне Перун сокирою – стане земля під ногами ворога могилою.",
    "id": "reading-85"
  },
  {
    "type": "prayer",
    "html": "Батько Велес рогом поверне – ворогу клятому в очі туману наверне.",
    "id": "reading-86"
  },
  {
    "type": "prayer",
    "html": "Не бачити, не чути, думок не зібрати – сила ворожа многая буде тікати.",
    "id": "reading-87"
  },
  {
    "type": "prayer",
    "html": "Стрибог стріли вогнянії в лиходіїв пускає, правду і мир Лада-Мати вертає.",
    "id": "reading-88"
  },
  {
    "type": "prayer",
    "html": "Хай Небо і Земля разом зберуться та кров&#039;ю окупанта доволі нап&#039;ються!",
    "id": "reading-89"
  },
  {
    "type": "prayer",
    "html": "День заснув, і ворог спить.",
    "id": "reading-90"
  },
  {
    "type": "prayer",
    "html": "Але ніч обійме в мить.",
    "id": "reading-91"
  },
  {
    "type": "prayer",
    "html": "Зуби клешні і копита, душа вража буде бита.",
    "id": "reading-92"
  },
  {
    "type": "prayer",
    "html": "Сама матінка Мара за тобою чужий воїне прийшла.",
    "id": "reading-93"
  },
  {
    "type": "prayer",
    "html": "І Велес батько тебе проведе,",
    "id": "reading-94"
  },
  {
    "type": "prayer",
    "html": "У палючім пеклі душа твоя помре.",
    "id": "reading-95"
  },
  {
    "type": "prayer",
    "html": "Не залишить нічка темна,",
    "id": "reading-96"
  },
  {
    "type": "prayer",
    "html": "Й попілинки вогкої від тебе.",
    "id": "reading-97"
  },
  {
    "type": "prayer",
    "html": "Нога там і нога тут поскакали враз в Москву.",
    "id": "reading-98"
  },
  {
    "type": "prayer",
    "html": "Голова теж покотилась до матусі захотілось.",
    "id": "reading-99"
  },
  {
    "type": "prayer",
    "html": "Тіло все мов той черв&#039;як поповзе собі хоч так.",
    "id": "reading-100"
  },
  {
    "type": "prayer",
    "html": "Брава сила божий дух, у московців враз потух.",
    "id": "reading-101"
  },
  {
    "type": "prayer",
    "html": "Ніч закрила оченята вже не буде він стріляти.",
    "id": "reading-102"
  },
  {
    "type": "prayer",
    "html": "Замовляння пронесеться, із землі воно береться і у землю далі йде, стовбнем ворога бере.",
    "id": "reading-103"
  },
  {
    "type": "prayer",
    "html": "Тихо піду, Землю обійду, біду відведу, вражу орду.",
    "id": "reading-104"
  },
  {
    "type": "prayer",
    "html": "Поруч Боже – Батечко, поруч весь Рід – братечко.",
    "id": "reading-105"
  },
  {
    "type": "prayer",
    "html": "Матінки, сестриці – блистки-перуниці...",
    "id": "reading-106"
  },
  {
    "type": "prayer",
    "html": "Поруч стоїмо, біду гонимо!",
    "id": "reading-107"
  },
  {
    "type": "prayer",
    "html": "Земельку боронимо! А чужинців – ворону!",
    "id": "reading-108"
  },
  {
    "type": "prayer",
    "html": "А чужинців в марево, в холодне вариво.",
    "id": "reading-109"
  },
  {
    "type": "prayer",
    "html": "Як прийшли – то згинули! Птахи очі винули!",
    "id": "reading-110"
  },
  {
    "type": "prayer",
    "html": "Не чіпай козаччину, ти не мав тут братчину!",
    "id": "reading-111"
  },
  {
    "type": "prayer",
    "html": "Боги тут нам родичі, а ви чужі байстрючі.",
    "id": "reading-112"
  },
  {
    "type": "prayer",
    "html": "Не ходи Вкраїнонькою, миршава вражинонька...",
    "id": "reading-113"
  },
  {
    "type": "prayer",
    "html": "Тут тобі не жити, тут нам сіять жито.",
    "id": "reading-114"
  },
  {
    "type": "prayer",
    "html": "Так сказано, клятвами зав&#039;язано.",
    "id": "reading-115"
  },
  {
    "type": "prayer",
    "html": "Так тому бути!",
    "id": "reading-116"
  }
]
