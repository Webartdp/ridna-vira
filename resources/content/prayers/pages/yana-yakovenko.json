[
  {
    "type": "prose",
    "html": "Яна (Ясна) Яковенко",
    "id": "reading-1"
  },
  {
    "type": "heading",
    "title": "До Богів",
    "id": "reading-2"
  },
  {
    "type": "prayer",
    "html": "Ввійдіть Боги Рідні",
    "id": "reading-3"
  },
  {
    "type": "prayer",
    "html": "в тіла і душі наші",
    "id": "reading-4"
  },
  {
    "type": "prayer",
    "html": "доброю силою",
    "id": "reading-5"
  },
  {
    "type": "prayer",
    "html": "і поведіть нас",
    "id": "reading-6"
  },
  {
    "type": "prayer",
    "html": "з добрими помислами",
    "id": "reading-7"
  },
  {
    "type": "prayer",
    "html": "на добрі справи,",
    "id": "reading-8"
  },
  {
    "type": "prayer",
    "html": "і проявіться в житті нашім",
    "id": "reading-9"
  },
  {
    "type": "prayer",
    "html": "добробутом, злагодою і здоров&#039;ям.",
    "id": "reading-10"
  },
  {
    "type": "prayer",
    "html": "Служити Роду йду",
    "id": "reading-11"
  },
  {
    "type": "prayer",
    "html": "По Божому сліду,",
    "id": "reading-12"
  },
  {
    "type": "prayer",
    "html": "Божими стопами.",
    "id": "reading-13"
  },
  {
    "type": "prayer",
    "html": "Хай руки мої стануть Божими руками,",
    "id": "reading-14"
  },
  {
    "type": "prayer",
    "html": "Хай очі мої стануть Божими очами,",
    "id": "reading-15"
  },
  {
    "type": "prayer",
    "html": "Хай слово моє стане Божими словами.",
    "id": "reading-16"
  },
  {
    "type": "heading",
    "title": "До Землі",
    "id": "reading-17"
  },
  {
    "type": "prayer",
    "html": "Земле рідна,",
    "id": "reading-18"
  },
  {
    "type": "prayer",
    "html": "Мати-Годувальнице,",
    "id": "reading-19"
  },
  {
    "type": "prayer",
    "html": "З Тебе виходимо,",
    "id": "reading-20"
  },
  {
    "type": "prayer",
    "html": "Малими і безпорадними,",
    "id": "reading-21"
  },
  {
    "type": "prayer",
    "html": "Під небом твоїм високим,",
    "id": "reading-22"
  },
  {
    "type": "prayer",
    "html": "Зростаємо і мужніємо,",
    "id": "reading-23"
  },
  {
    "type": "prayer",
    "html": "Серця свої, працю рук своїх,",
    "id": "reading-24"
  },
  {
    "type": "prayer",
    "html": "Тобі присвячуємо",
    "id": "reading-25"
  },
  {
    "type": "prayer",
    "html": "Красу і славу Твою множачи.",
    "id": "reading-26"
  },
  {
    "type": "prayer",
    "html": "Земле рідна,",
    "id": "reading-27"
  },
  {
    "type": "prayer",
    "html": "Покрово-Заступнице,",
    "id": "reading-28"
  },
  {
    "type": "prayer",
    "html": "На схилі літ своїх",
    "id": "reading-29"
  },
  {
    "type": "prayer",
    "html": "До Тебе вертаємося,",
    "id": "reading-30"
  },
  {
    "type": "prayer",
    "html": "Щоб пригорнула Ти",
    "id": "reading-31"
  },
  {
    "type": "prayer",
    "html": "Серця великі і руки натруджені",
    "id": "reading-32"
  },
  {
    "type": "prayer",
    "html": "Дітей своїх, даючи їм",
    "id": "reading-33"
  },
  {
    "type": "prayer",
    "html": "Прилисток і спочинок.",
    "id": "reading-34"
  },
  {
    "type": "prayer",
    "html": "Земле рідна,",
    "id": "reading-35"
  },
  {
    "type": "prayer",
    "html": "Свята, пречиста,",
    "id": "reading-36"
  },
  {
    "type": "prayer",
    "html": "Тебе заповідали на пращурі наші,",
    "id": "reading-37"
  },
  {
    "type": "prayer",
    "html": "І ми передамо тебе",
    "id": "reading-38"
  },
  {
    "type": "prayer",
    "html": "В руки правнуків своїх,",
    "id": "reading-39"
  },
  {
    "type": "prayer",
    "html": "Як найбільшу святиню,",
    "id": "reading-40"
  },
  {
    "type": "prayer",
    "html": "Щоб несли вони у віки",
    "id": "reading-41"
  },
  {
    "type": "prayer",
    "html": "Заповіт роду нашого",
    "id": "reading-42"
  },
  {
    "type": "prayer",
    "html": "Любити і берегти Тебе,",
    "id": "reading-43"
  },
  {
    "type": "prayer",
    "html": "Щоб родила Ти нами у всі віки,",
    "id": "reading-44"
  },
  {
    "type": "prayer",
    "html": "Допоки небо стоятиме над тобою.",
    "id": "reading-45"
  },
  {
    "type": "heading",
    "title": "До Мокоші",
    "id": "reading-46"
  },
  {
    "type": "prayer",
    "html": "Матінко Мокошо,",
    "id": "reading-47"
  },
  {
    "type": "prayer",
    "html": "Спряди нам хорошу",
    "id": "reading-48"
  },
  {
    "type": "prayer",
    "html": "Долі нитку гожу",
    "id": "reading-49"
  },
  {
    "type": "prayer",
    "html": "Онукам Дажбожим.",
    "id": "reading-50"
  },
  {
    "type": "prayer",
    "html": "У Божій оселі",
    "id": "reading-51"
  },
  {
    "type": "prayer",
    "html": "З чистої куделі.",
    "id": "reading-52"
  },
  {
    "type": "prayer",
    "html": "Веретенце крутиться,",
    "id": "reading-53"
  },
  {
    "type": "prayer",
    "html": "Моє слово збудеться!",
    "id": "reading-54"
  },
  {
    "type": "prayer",
    "html": "Спряди нитку вміло",
    "id": "reading-55"
  },
  {
    "type": "prayer",
    "html": "Для душі і тіла,",
    "id": "reading-56"
  },
  {
    "type": "prayer",
    "html": "Міцну та рівненьку",
    "id": "reading-57"
  },
  {
    "type": "prayer",
    "html": "На життя гладеньке,",
    "id": "reading-58"
  },
  {
    "type": "prayer",
    "html": "Тоненьку та довгу",
    "id": "reading-59"
  },
  {
    "type": "prayer",
    "html": "В щасливу дорогу.",
    "id": "reading-60"
  },
  {
    "type": "prayer",
    "html": "Веретенце крутиться",
    "id": "reading-61"
  },
  {
    "type": "prayer",
    "html": "Моє слово збудеться!!!",
    "id": "reading-62"
  },
  {
    "type": "heading",
    "title": "До Стрибога",
    "id": "reading-63"
  },
  {
    "type": "prayer",
    "html": "Вітре-Стрибоже, Сину Сварожий –",
    "id": "reading-64"
  },
  {
    "type": "prayer",
    "html": "Ти наповнюєш на світі все живе і неживе собою.",
    "id": "reading-65"
  },
  {
    "type": "prayer",
    "html": "З Тобою приходить життя в перший крик немовляти,",
    "id": "reading-66"
  },
  {
    "type": "prayer",
    "html": "з Тобою відходить душа людська на Луки Сварожі.",
    "id": "reading-67"
  },
  {
    "type": "prayer",
    "html": "Ти напинаєш вітрила,",
    "id": "reading-68"
  },
  {
    "type": "prayer",
    "html": "і човен Життя пливе по колу вічності",
    "id": "reading-69"
  },
  {
    "type": "prayer",
    "html": "і ніколи не зупиняється.",
    "id": "reading-70"
  },
  {
    "type": "prayer",
    "html": "Наповни, Стрибоже,",
    "id": "reading-71"
  },
  {
    "type": "prayer",
    "html": "тіла наші силою,",
    "id": "reading-72"
  },
  {
    "type": "prayer",
    "html": "а дух наш могутністю Своєю.",
    "id": "reading-73"
  },
  {
    "type": "heading",
    "title": "Молитви при пологах",
    "id": "reading-74"
  },
  {
    "type": "prayer",
    "html": "Летіла лелека",
    "id": "reading-75"
  },
  {
    "type": "prayer",
    "html": "З-за Дунаю далекого",
    "id": "reading-76"
  },
  {
    "type": "prayer",
    "html": "Принесла новиночку",
    "id": "reading-77"
  },
  {
    "type": "prayer",
    "html": "Про мою дитиночку.",
    "id": "reading-78"
  },
  {
    "type": "prayer",
    "html": "Вже вона в дорогу збирається,",
    "id": "reading-79"
  },
  {
    "type": "prayer",
    "html": "На світ білий благословляється.",
    "id": "reading-80"
  },
  {
    "type": "prayer",
    "html": "Віконечко відчиняю,",
    "id": "reading-81"
  },
  {
    "type": "prayer",
    "html": "Гостя довгожданого виглядаю",
    "id": "reading-82"
  },
  {
    "type": "prayer",
    "html": "Через високі пороги,",
    "id": "reading-83"
  },
  {
    "type": "prayer",
    "html": "З далекої дороги,",
    "id": "reading-84"
  },
  {
    "type": "prayer",
    "html": "Я дитя своє зустрічаю,",
    "id": "reading-85"
  },
  {
    "type": "prayer",
    "html": "Про поміч Велесову благаю.",
    "id": "reading-86"
  },
  {
    "type": "prayer",
    "html": "На мости калинові",
    "id": "reading-87"
  },
  {
    "type": "prayer",
    "html": "Ставлю дощечки нові,",
    "id": "reading-88"
  },
  {
    "type": "prayer",
    "html": "Стежечки килимами вистеляю,",
    "id": "reading-89"
  },
  {
    "type": "prayer",
    "html": "Сонечко до них прихиляю,",
    "id": "reading-90"
  },
  {
    "type": "prayer",
    "html": "Місяцем підсвічую,",
    "id": "reading-91"
  },
  {
    "type": "prayer",
    "html": "Зорями заквітчую,",
    "id": "reading-92"
  },
  {
    "type": "prayer",
    "html": "Щоб була стежинка світленька,",
    "id": "reading-93"
  },
  {
    "type": "prayer",
    "html": "Щоб була доріжка легенька.",
    "id": "reading-94"
  },
  {
    "type": "prayer",
    "html": "А по ній Сам Велес іде,",
    "id": "reading-95"
  },
  {
    "type": "prayer",
    "html": "Дитя моє веде,",
    "id": "reading-96"
  },
  {
    "type": "prayer",
    "html": "Через усі пороги переступає,",
    "id": "reading-97"
  },
  {
    "type": "prayer",
    "html": "Дитя моє на життя красне благословляє.",
    "id": "reading-98"
  },
  {
    "type": "prayer",
    "html": "Матір Дажбога,",
    "id": "reading-99"
  },
  {
    "type": "prayer",
    "html": "Рожаниця Пресвітла",
    "id": "reading-100"
  },
  {
    "type": "prayer",
    "html": "По двору ходить,",
    "id": "reading-101"
  },
  {
    "type": "prayer",
    "html": "У білій рученьці",
    "id": "reading-102"
  },
  {
    "type": "prayer",
    "html": "Ключі золотії носить,",
    "id": "reading-103"
  },
  {
    "type": "prayer",
    "html": "Запори таємнії відчиняє,",
    "id": "reading-104"
  },
  {
    "type": "prayer",
    "html": "Ворота дубовії відкриває,",
    "id": "reading-105"
  },
  {
    "type": "prayer",
    "html": "Дитя моє на світ Божий",
    "id": "reading-106"
  },
  {
    "type": "prayer",
    "html": "Випускає.",
    "id": "reading-107"
  },
  {
    "type": "prayer",
    "html": "Земле Свята,",
    "id": "reading-108"
  },
  {
    "type": "prayer",
    "html": "Мати Пресвітла,",
    "id": "reading-109"
  },
  {
    "type": "prayer",
    "html": "Рожанице пречиста!",
    "id": "reading-110"
  },
  {
    "type": "prayer",
    "html": "Ти маєш ключі золоті,",
    "id": "reading-111"
  },
  {
    "type": "prayer",
    "html": "Відкриваєш замки потайні,",
    "id": "reading-112"
  },
  {
    "type": "prayer",
    "html": "Випускаєш із Лона Свого",
    "id": "reading-113"
  },
  {
    "type": "prayer",
    "html": "Дитя Красне – Сонце Ясне.",
    "id": "reading-114"
  },
  {
    "type": "prayer",
    "html": "Молю тебе, Земле –Матінко,",
    "id": "reading-115"
  },
  {
    "type": "prayer",
    "html": "Відімкни запори лона мого,",
    "id": "reading-116"
  },
  {
    "type": "prayer",
    "html": "Випусти дитя гоже",
    "id": "reading-117"
  },
  {
    "type": "prayer",
    "html": "На світ Божий.",
    "id": "reading-118"
  },
  {
    "type": "prayer",
    "html": "Стежечка рівнесенька,",
    "id": "reading-119"
  },
  {
    "type": "prayer",
    "html": "Доленька гарнесенька,",
    "id": "reading-120"
  },
  {
    "type": "prayer",
    "html": "Перун попереду,",
    "id": "reading-121"
  },
  {
    "type": "prayer",
    "html": "Велес позаду,",
    "id": "reading-122"
  },
  {
    "type": "prayer",
    "html": "Рідна Земля під ногами –",
    "id": "reading-123"
  },
  {
    "type": "prayer",
    "html": "Проти ворога",
    "id": "reading-124"
  },
  {
    "type": "prayer",
    "html": "З Рідними Богами!",
    "id": "reading-125"
  },
  {
    "type": "heading",
    "title": "Жива-Дівиця",
    "id": "reading-126"
  },
  {
    "type": "prayer",
    "html": "Ой на морі Дунаю та й острів стоїть,",
    "id": "reading-127"
  },
  {
    "type": "prayer",
    "html": "А на тому острові пісок золотий лежить,",
    "id": "reading-128"
  },
  {
    "type": "prayer",
    "html": "А на тому золотому пісочку",
    "id": "reading-129"
  },
  {
    "type": "prayer",
    "html": "Росте міцний дубочок,",
    "id": "reading-130"
  },
  {
    "type": "prayer",
    "html": "А під дубочком криниця",
    "id": "reading-131"
  },
  {
    "type": "prayer",
    "html": "А в тій криниці жива водиця.",
    "id": "reading-132"
  },
  {
    "type": "prayer",
    "html": "А біля криниці сидить Діва",
    "id": "reading-133"
  },
  {
    "type": "prayer",
    "html": "Трисвітла Жива,",
    "id": "reading-134"
  },
  {
    "type": "prayer",
    "html": "Вона тої води живої",
    "id": "reading-135"
  },
  {
    "type": "prayer",
    "html": "У глечик розписний набирає,",
    "id": "reading-136"
  },
  {
    "type": "prayer",
    "html": "Усе живе напуває,",
    "id": "reading-137"
  },
  {
    "type": "prayer",
    "html": "Силою наділяє.",
    "id": "reading-138"
  },
  {
    "type": "prayer",
    "html": "Я трьох голубів закликаю,",
    "id": "reading-139"
  },
  {
    "type": "prayer",
    "html": "По тую живу водицю посилаю,",
    "id": "reading-140"
  },
  {
    "type": "prayer",
    "html": "Як ті голуби Дунай море перелітають,",
    "id": "reading-141"
  },
  {
    "type": "prayer",
    "html": "На острів сідають,",
    "id": "reading-142"
  },
  {
    "type": "prayer",
    "html": "По золотому пісочку походжають,",
    "id": "reading-143"
  },
  {
    "type": "prayer",
    "html": "Біля дубочка спочивають,",
    "id": "reading-144"
  },
  {
    "type": "prayer",
    "html": "Живої води у дзьобики набирають,",
    "id": "reading-145"
  },
  {
    "type": "prayer",
    "html": "Та й до мене вертають,",
    "id": "reading-146"
  },
  {
    "type": "prayer",
    "html": "Живу воду на тіло біле проливають,",
    "id": "reading-147"
  },
  {
    "type": "prayer",
    "html": "А де жива водиця стікає,",
    "id": "reading-148"
  },
  {
    "type": "prayer",
    "html": "Там хворі-болі пропадають,",
    "id": "reading-149"
  },
  {
    "type": "prayer",
    "html": "Сили здоров&#039;я прибувають.",
    "id": "reading-150"
  },
  {
    "type": "prayer",
    "html": "А як перший голуб живу водицю на тіло біле проливає,",
    "id": "reading-151"
  },
  {
    "type": "prayer",
    "html": "З онука Дажбожого хвороба стікає,",
    "id": "reading-152"
  },
  {
    "type": "prayer",
    "html": "А як другий голуб живу водицю на тіло біле проливає,",
    "id": "reading-153"
  },
  {
    "type": "prayer",
    "html": "Онуку Дажбожому сили прибуває,",
    "id": "reading-154"
  },
  {
    "type": "prayer",
    "html": "А як третій голуб живу водицю на тіло біле проливає,",
    "id": "reading-155"
  },
  {
    "type": "prayer",
    "html": "Онуку Дажбожому здоров&#039;я прибуває.",
    "id": "reading-156"
  },
  {
    "type": "prayer",
    "html": "І по слову моєму збувається,",
    "id": "reading-157"
  },
  {
    "type": "prayer",
    "html": "Сили здоров&#039;я онуку Дажбожому повертаються,",
    "id": "reading-158"
  },
  {
    "type": "prayer",
    "html": "А Жива-Дівиця золотим ключем повертає,",
    "id": "reading-159"
  },
  {
    "type": "prayer",
    "html": "Слово моє на замок закриває.",
    "id": "reading-160"
  },
  {
